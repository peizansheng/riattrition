lci <- function(N, x, n, alpha) {
# alpha = 0 gives the trivial bound x
if (alpha == 0) {
return(x)
}
kk <- 1:length(x)
for (i in kk) {
if (x[i] < 0.5) {
kk[i] <- 0
} else {
aa <- 0:N
bb <- aa + 1
bb[2:(N + 1)] <- stats::phyper(x[i] - 1, aa[2:(N + 1)] - 1, N - aa[2:(N + 1)] + 1, n)
dd <- cbind(aa, bb)
dd <- dd[which(dd[, 2] >= 1 - alpha), ]
if (length(dd) == 2) {
kk[i] <- dd[1]
} else {
kk[i] <- max(dd[, 1])
}
}
}
return(kk)
}
lci(N = 100, x = 50, n = 50, alpha = 0.1)
lci(N = 100, x = 50, n = 50, alpha = 0)
uci(N = 100, x = 50, n = 50, alpha = 0.1)
