assign_CRE <- function(n, m, nperm) {
Z.perm <- matrix(0, nrow = n, ncol = nperm)
for (iter in 1:nperm) {
Z.perm[sample(c(1:n), m, replace = FALSE), iter] <- 1
}
return(Z.perm)
}
t1 <- assign_CRE(n = 5, m = 3, nperm = 10^4)
set.seed(1)
t1 <- assign_CRE(n = 5, m = 3, nperm = 10^4)
t1
assign_CRE <- function(n, m, nperm) {
Z.perm <- matrix(0, nrow = n, ncol = nperm)
for (iter in 1:nperm) {
Z.perm[sample.int(n, m), iter] <- 1
}
return(Z.perm)
}
set.seed(1)
t2 <- assign_CRE(n = 5, m = 3, nperm = 10^4)
is.identical(t1, t2)
t1 == t2
sum(t1 == t2)
sum(!(t1 == t2))
library(devtools)
